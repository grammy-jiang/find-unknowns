{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unknowns-ledger-v1",
  "title": "Unknowns Ledger v1 — frontmatter contract",
  "description": "Frontmatter of a find-unknowns ledger (notes/unknowns/<feature-slug>-YYYYMMDD.md). Body entries (## UNK-NNN sections) and quiz sections are validated by validator.py, which this schema cannot express; references/ledger-contract.md is the prose source of truth and must stay in lockstep.",
  "type": "object",
  "required": [
    "schema",
    "feature",
    "created",
    "updated",
    "status",
    "quiz_passed",
    "quiz_attempts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "unknowns-ledger-v1"
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": ["active", "complete", "abandoned"]
    },
    "quiz_passed": {
      "type": "boolean"
    },
    "quiz_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    }
  }
}
